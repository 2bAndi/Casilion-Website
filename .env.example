# Cassilion web platform - configuration for the server
#
# Copy to .env on the server and fill in the five empty values (SECRET_KEY, POSTGRES_PASSWORD,
# EMAIL_HOST_PASSWORD, SANDBOX_WEBHOOK_SECRET, AI_WORKER_TOKEN). Never commit .env.
# Local development needs no .env at all: `python manage.py dev` runs with built-in
# development values (DEBUG on, SQLite, mails on the console).

# --- Web application ------------------------------------------------------------------
DEBUG=0
# python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
SITE_URL=https://cassilion.com
# "web" is the name the AI worker uses inside the Docker network
ALLOWED_HOSTS=cassilion.com,www.cassilion.com,cassilion.de,www.cassilion.de,web
CSRF_TRUSTED_ORIGINS=https://cassilion.com
# Keep search engines out: header "noindex, nofollow", the same meta tag, closed robots.txt.
# Set to 0 only when the site is meant to be found.
SITE_NOINDEX=1
# HTTPS for good: first 86400 (one day), after a check 31536000 (one year). 0 = off.
SECURE_HSTS_SECONDS=0
#LOG_LEVEL=INFO

# --- Company data on the legal pages --------------------------------------------------------
# Imprint, privacy notice, terms and withdrawal policy read the provider's data from here.
# The defaults are those of Zuri-AI GmbH; set a line only to change a value.
# A VAT ID or a business identification number (W-IdNr.) MUST be entered once the company
# has one: the imprint then shows it (section 5 (1) no. 6 DDG).
#COMPANY_VAT_ID=
#COMPANY_ECON_ID=
#COMPANY_EMAIL=contact@zuri-ai.com
#COMPANY_PHONE=+49 151 11572555
# Date shown as "last updated" on the legal pages and stored with each order
#LEGAL_AS_OF=2026-11-20

# --- Database (the same three values configure the database container) --------------------
POSTGRES_DB=cassilion
POSTGRES_USER=cassilion
# python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=
#POSTGRES_HOST=db
#POSTGRES_PORT=5432
# Alternative to the POSTGRES_ values, for a database outside the stack:
#DATABASE_URL=postgres://user:password@host:5432/name

# --- Mail -----------------------------------------------------------------------------
# Without EMAIL_HOST, mails (address confirmation, ticket notices, alerts) are only written
# to the app log: docker compose logs web | grep -A20 Subject
# On this server: the server's own mail platform, which relays to Brevo; the login is the
# mailbox of the sending address (see docs/server-setup.md, section 6).
EMAIL_HOST=mail.kinhavn.de
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_HOST_USER=info@cassilion.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Cassilion <info@cassilion.com>
# Suspected bugs, critical tickets and server errors go here (comma separated)
OPERATOR_EMAILS=info@cassilion.com
# optional | mandatory. Default with DEBUG=0: mandatory (a new account must confirm its address).
ACCOUNT_EMAIL_VERIFICATION=mandatory

# --- Accounts and agents ----------------------------------------------------------------
# A customer needs two-factor authentication before creating an agent token (default with DEBUG=0: on)
#REQUIRE_MFA_FOR_AGENT_TOKENS=1
# Host and Origin headers the MCP endpoints accept (DNS-rebinding protection)
MCP_ALLOWED_HOSTS=cassilion.com,cassilion.com:*
MCP_ALLOWED_ORIGINS=https://cassilion.com

# --- Payments ---------------------------------------------------------------------------
# Only "sandbox" exists so far: a stand-in checkout where NO money moves and anyone who
# registers can give themselves any plan. The application refuses to start with DEBUG=0
# unless this is acknowledged here. Remove the line when a real provider is configured.
PAYMENT_PROVIDER=sandbox
ALLOW_SANDBOX_PAYMENTS=1
# python3 -c "import secrets; print(secrets.token_urlsafe(24))"
SANDBOX_WEBHOOK_SECRET=
#GRACE_DAYS=14

# --- Licenses and downloads -------------------------------------------------------------
# The stand-in license file is signed with an Ed25519 key in data/var/keys, created on first
# use while this is 1. (The product's real licenses come from its own offline issuer.)
LICENSE_AUTOCREATE_KEY=1
#LICENSE_KEY_ID=cas-lic-2026
#DOWNLOAD_LINK_SECONDS=600

# --- AI worker --------------------------------------------------------------------------
# Shared secret between the web application and the worker (both read this file).
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AI_WORKER_TOKEN=
AI_WORKER_ID=worker-1
AI_POLL_SECONDS=3
JOB_LEASE_SECONDS=600

# stub   = rule-based analysis, no model (default)
# openai = any OpenAI-compatible endpoint: Ollama, vLLM, llama.cpp server, LM Studio.
#          A worker that uses a model or reads the product source does not run on this
#          server (docker-compose.yml, service ai-worker).
#LLM_BACKEND=stub
#LLM_BASE_URL=http://127.0.0.1:11434/v1
#LLM_MODEL=
#LLM_API_KEY=
#LLM_TIMEOUT=300
# Read-only checkout of the product's source for the analyst stage (never on this server)
#PRODUCT_REPO_DIR=
# Extra strings that must never appear in a reply (also: knowledge/internal/canaries.txt)
#CANARY_STRINGS=

# --- Backups ----------------------------------------------------------------------------
# Optional off-site copy of the backups (rsync target, needs an SSH key)
#BACKUP_RSYNC_TARGET=
